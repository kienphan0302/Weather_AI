# No environment variables or API keys are required.
# Forecasts: https://api.open-meteo.com/v1/forecast
# City search: https://geocoding-api.open-meteo.com/v1/search
# EXPO_PUBLIC_ values are embedded in the browser bundle. Never put secrets here.

# Local agent platform only (Node 24, loopback binding cannot be overridden).
# AGENT_PORT=8787
# Optional server-only key: enables the regular Agents SDK dispatcher.
# OPENAI_API_KEY=
# Optional SDK model override; omitted uses the installed SDK default.
# AGENT_MODEL=
# AGENT_MEMORY_CONTEXT is internal runtime transport, not user configuration.

# Agent server: maximum simultaneous attempts (integer 1–4; paused attempts retain a slot).
# AGENT_CONCURRENCY=1
