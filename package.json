{
  "name": "weather-agent",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web",
    "test": "node --test tests/*.test.ts",
    "agent": "node scripts/agent-v2.mjs",
    "agent:v2": "node scripts/agent-v2.mjs",
    "agent:server": "node agent-platform/server.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@openai/agents": "^0.21.0",
    "expo": "^58.0.19",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
